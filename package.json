{
  "name": "roayn-corporate-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:content && next build",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "check:links": "node scripts/check-static-links.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm run check:links"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
